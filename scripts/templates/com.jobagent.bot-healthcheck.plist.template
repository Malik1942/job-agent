<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobagent.bot-healthcheck</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__JOBAGENT_DIR__/scripts/bot_healthcheck.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__JOBAGENT_DIR__</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardErrorPath</key>
  <string>__JOBAGENT_DIR__/output/bot-healthcheck.launchd.err.log</string>
</dict>
</plist>
