# Copy to scripts/.env and fill in. This file is loaded by run_daily.sh and is
# git-ignored so secrets never get committed. Do NOT put secrets in config.yaml.

# Gmail app password (create one at myaccount.google.com, not your login password)
JOBAGENT_SMTP_PASSWORD=

# Slack incoming webhook URL (create at api.slack.com/messaging/webhooks)
JOBAGENT_SLACK_WEBHOOK=
JOBAGENT_SLACK_CHANNEL=

# Optional: fixed token for the phone approval web panel.
# Leave blank to let jobagent create output/approval-web-token.
JOBAGENT_APPROVAL_WEB_TOKEN=

# Slack mobile approval buttons via Socket Mode.
# Bot token starts with xoxb-, app-level token starts with xapp-.
JOBAGENT_SLACK_BOT_TOKEN=
JOBAGENT_SLACK_APP_TOKEN=

# Optional: only needed if you enable LLM cover letters / answers.
# Claude environment:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
#
# OpenAI / Codex-compatible environment:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=https://api.openai.com/v1
